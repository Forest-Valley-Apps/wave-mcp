{
  "name": "wave-mcp",
  "version": "1.0.0",
  "description": "MCP server for Wave Accounting: invoicing, customers, products, transaction entry and reporting via GraphQL. Wave's public API has no bill schema, so bill tools report themselves unsupported.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "wave-mcp": "./build/main.js"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "test": "npm run build && node --test \"build/**/*.test.js\"",
    "watch": "tsc --watch",
    "dev": "tsc && node build/main.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "graphql": "^16.8.1",
    "graphql-request": "^6.1.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
